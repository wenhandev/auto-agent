{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "default",
  "description": "Default capabilities for Auto Agent desktop",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:tray:default",
    "core:window:default",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "opener:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://127.0.0.1:8001/**" },
        { "url": "http://localhost:8001/**" },
        { "url": "https://rpa.wenhandev.com/**" }
      ]
    }
  ]
}