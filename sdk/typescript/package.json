{
  "name": "auto-agent-sdk",
  "version": "0.1.0",
  "description": "TypeScript client for the auto-agent /api/v1 public API.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
