{
  "name": "Acme Supply Hub Demo",
  "description": "Deterministic demo workflow (login + reCAPTCHA → orders → invoices → support)",
  "workflow": {
    "nodes": [
      {"id": "start", "type": "start", "label": "Start", "params": {}},
      {"id": "n1", "type": "navigate", "label": "Open portal", "params": {"url": "{{DEMO_URL}}"}},
      {"id": "n2", "type": "fill", "label": "Email", "params": {"selector": "[data-testid=login-email]", "value": "demo@acme.com", "auto_heal": false}},
      {"id": "n3", "type": "fill", "label": "Password", "params": {"selector": "[data-testid=login-password]", "value": "demo1234", "auto_heal": false}},
      {"id": "n4", "type": "wait", "label": "Advance to reCAPTCHA", "params": {"ms": 800}},
      {"id": "n5", "type": "wait", "label": "reCAPTCHA widget load", "params": {"ms": 5000}},
      {"id": "n6", "type": "fuzzy_action", "label": "Click reCAPTCHA", "params": {"action": "click_recaptcha"}},
      {"id": "n7", "type": "wait", "label": "After captcha click", "params": {"ms": 800}},
      {"id": "n8", "type": "click", "label": "Verify reCAPTCHA", "params": {"selector": "[data-testid=recaptcha-verify]", "auto_heal": false}},
      {"id": "n9", "type": "wait", "label": "Dashboard", "params": {"ms": 1000}},
      {"id": "n10", "type": "click", "label": "Nav orders", "params": {"selector": "[data-testid=nav-orders]", "auto_heal": false}},
      {"id": "n11", "type": "fill", "label": "Filter order", "params": {"selector": "[data-testid=filter-order-id]", "value": "8842", "auto_heal": false}},
      {"id": "n12", "type": "click", "label": "Search", "params": {"selector": "[data-testid=filter-submit]", "auto_heal": false}},
      {"id": "n13", "type": "click", "label": "Select order", "params": {"selector": "[data-testid=order-row-PO-2024-8842]", "auto_heal": false}},
      {"id": "n14", "type": "wait", "label": "Order detail", "params": {"ms": 400}},
      {"id": "n15", "type": "extract", "label": "Extract order JSON", "params": {"instruction": "Return the JSON text from [data-testid=order-json]"}},
      {"id": "n16", "type": "click", "label": "Nav invoices", "params": {"selector": "[data-testid=nav-invoices]", "auto_heal": false}},
      {"id": "n17", "type": "click", "label": "Download invoice", "params": {"selector": "[data-testid=download-summary-INV-2024-3325]", "auto_heal": false}},
      {"id": "n18", "type": "wait", "label": "Invoice panel", "params": {"ms": 400}},
      {"id": "n19", "type": "extract", "label": "Extract invoice JSON", "params": {"instruction": "Return the JSON text from [data-testid=invoice-json]"}},
      {"id": "n20", "type": "click", "label": "Nav support", "params": {"selector": "[data-testid=nav-support]", "auto_heal": false}},
      {"id": "n21", "type": "fill", "label": "Ticket category", "params": {"selector": "[data-testid=ticket-category]", "value": "integration", "auto_heal": false}},
      {"id": "n22", "type": "click", "label": "Support next 1", "params": {"selector": "[data-testid=support-next-1]", "auto_heal": false}},
      {"id": "n23", "type": "fill", "label": "Ticket subject", "params": {"selector": "[data-testid=ticket-subject]", "value": "API webhook delay", "auto_heal": false}},
      {"id": "n24", "type": "fill", "label": "Ticket description", "params": {"selector": "[data-testid=ticket-description]", "value": "EDI 856 acknowledgments are delayed by 2 hours since Nov 28", "auto_heal": false}},
      {"id": "n25", "type": "click", "label": "Support next 2", "params": {"selector": "[data-testid=support-next-2]", "auto_heal": false}},
      {"id": "n26", "type": "wait", "label": "Support review step", "params": {"ms": 600}},
      {"id": "n27", "type": "click", "label": "Submit ticket", "params": {"selector": "[data-testid=support-submit]", "auto_heal": false}},
      {"id": "n28", "type": "wait", "label": "Ticket success", "params": {"ms": 600}},
      {"id": "n29", "type": "extract", "label": "Extract ticket JSON", "params": {"instruction": "Return the JSON text from [data-testid=ticket-json]"}},
      {"id": "end", "type": "end", "label": "End", "params": {}}
    ],
    "edges": [
