# Production control plane for https://rpa.wenhandev.com
# Copy to deploy/.env and fill in secrets before `docker compose up -d`.

DOMAIN=rpa.wenhandev.com
ACME_EMAIL=admin@wenhandev.com

# Control plane only — browser/LLM execution runs on desktop clients.
EXECUTION_BACKEND=control_plane_only

# Required — change before first deploy
SESSION_SECRET=replace-with-long-random-string
# Bootstrap admin — use the Google account that will sign in (domain allowlist is separate)
ADMIN_EMAIL=wenhan.development@gmail.com
ADMIN_PASSWORD=replace-with-strong-password

# Public URLs (used for OAuth callbacks and redirects)
OAUTH_CALLBACK_BASE=https://rpa.wenhandev.com
FRONTEND_BASE_URL=https://rpa.wenhandev.com
# Desktop OAuth redirect target (Tauri localhost callback server on port 8745)
DESKTOP_CLIENT_BASE_URL=http://127.0.0.1:8745
CORS_ORIGINS=https://rpa.wenhandev.com,http://localhost:5173
# Desktop Tauri origins (http://tauri.localhost, tauri://localhost, etc.) are added automatically.

# Google login (same OAuth client as doc-agent; add redirect URI below)
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=
# BOOTSTRAP_PLATFORM_ADMIN=true
# BOOTSTRAP_OAUTH_ONLY=true
# OAUTH_PASSWORD_LOGIN_ENABLED=false
# Allow first-time Google sign-in for matching email domains (required when password login is off)
OAUTH_SIGNUP_POLICY=domain_allowlist
OAUTH_ALLOWED_EMAIL_DOMAINS=wenhandev.com
# Domain allowlist only matches email *domains* (@wenhandev.com), not individual Gmail addresses.
# For a bootstrap admin on another domain (e.g. @gmail.com), pre-create the user in DB or set
# ADMIN_EMAIL to that address with BOOTSTRAP_PLATFORM_ADMIN=true before first OAuth login.
# Optional: per-org domain rules via admin API instead of OAUTH_ALLOWED_EMAIL_DOMAINS

# SQLite on persistent volume (default). For Postgres, set DATABASE_URL in compose override.
# DATABASE_URL=postgresql+psycopg://user:pass@postgres/auto_agent

# Optional: cloud LLM for workflow generation in admin UI (not required for desktop runs)
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
