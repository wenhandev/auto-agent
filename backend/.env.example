LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
# Optional: custom OpenAI-compatible gateway (Bosch internal, Azure OpenAI, etc.)
# OPENAI_BASE_URL=https://llmapis.documind.bosch-app.com/v1
# Google AI Studio API key (when GEMINI_PROVIDER=ai_studio)
# GOOGLE_API_KEY=...

# Vertex AI (same as voice2navigation — uses gcloud / ADC, no API key)
# GEMINI_PROVIDER=vertex
# GCP_PROJECT=doc-agent-496311
# GCP_LOCATION=global
# GOOGLE_MODEL=gemini-3.1-flash-lite
# Optional: Google-native Gemini relay (Bosch internal etc.). Leave unset
# to talk directly to Google AI Studio.
# GOOGLE_BASE_URL=https://llmapis.documind.bosch-app.com
BROWSER_HEADLESS=false
# When headed, skip optional screenshots/CDP screencast (prevents window flicker)
BROWSER_SKIP_HEADED_SCREENSHOTS=true
BROWSER_VIEWPORT_WIDTH=1280
BROWSER_VIEWPORT_HEIGHT=720
# Google reCAPTCHA v2 test keys (https://developers.google.com/recaptcha/docs/faq)
# RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
# RECAPTCHA_SECRET_KEY=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe
FUZZY_MAX_STEPS=8
VISION_MAX_STEPS=8
# Scheduler trigger hygiene (startup registration caps)
TRIGGER_MAX_ACTIVE=50
TRIGGER_STALE_DAYS=30
TRIGGER_MAX_POLL_PER_WORKFLOW=10
# Live browser viewport stream (CDP screencast, /ws/stream/{run_id})
STREAM_FPS=8
STREAM_JPEG_QUALITY=60
STREAM_MAX_WIDTH=1280
# Run artifacts / session recording
# VIDEO_RECORDING_ENABLED=false
# HAR_ENABLED=true
SESSION_IDLE_MINUTES=30
MAX_LIVE_SESSIONS=5

# Credential backends (default mount: local Fernet vault)
# CREDENTIAL_BACKEND=local
#
# Read-only env mount: set AUTOAGENT_CRED_<NAME>_<FIELD> variables.
# Example: AUTOAGENT_CRED_GITHUB_PASSWORD=secret resolves {{cred.env:github.password}}
# Unprefixed {{cred.github.password}} uses CREDENTIAL_BACKEND (local by default).
# AUTOAGENT_CRED_GITHUB_PASSWORD=
# AUTOAGENT_CRED_GITHUB_USERNAME=
#
# Read-only HTTP vault mount: {{cred.http_vault:<name>.<field>}}
# GET {HTTP_VAULT_URL}/{name} returns a JSON object of credential fields.
# HTTP_VAULT_URL=https://vault.example.com/credentials
# HTTP_VAULT_AUTH_HEADER=Bearer your-token

# Local runtime worker (edge execution)
# WORKER_HEARTBEAT_INTERVAL_SEC=30
# WORKER_HEARTBEAT_TIMEOUT_SEC=90
# WORKER_SESSION_TTL_DAYS=30
# EXECUTION_BACKEND=full
# EXECUTION_BACKEND=control_plane_only

# Cloud / production (see deploy/README.md)
# DATABASE_URL=sqlite:///./auto_agent.db
# CORS_ORIGINS=http://localhost:5173,https://rpa.wenhandev.com
# OAUTH_CALLBACK_BASE=https://rpa.wenhandev.com
# FRONTEND_BASE_URL=https://rpa.wenhandev.com
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=
# BOOTSTRAP_OAUTH_ONLY=true
# OAUTH_PASSWORD_LOGIN_ENABLED=false
# BOOTSTRAP_PLATFORM_ADMIN=true
# OAUTH_SIGNUP_POLICY=existing_users_only
# SESSION_SECRET=change-me-in-production
# ADMIN_EMAIL=admin@wenhandev.com
# ADMIN_PASSWORD=
