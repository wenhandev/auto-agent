{
  "app": "notion",
  "version": "1.0.0",
  "credentials": ["notion_oauth2", "notion_internal_token"],
  "resources": [
    {
      "name": "pages",
      "label": "Pages",
      "operations": [
        {
          "name": "create",
          "label": "Create Page",
          "fields": [
            {"name": "parent", "label": "Parent", "kind": "json", "required": true},
            {"name": "properties", "label": "Properties", "kind": "json", "required": false, "default": {}},
            {"name": "children", "label": "Children", "kind": "json", "required": false, "default": []}
          ],
          "request": {
            "method": "POST",
            "url": "https://api.notion.com/v1/pages",
            "headers": {
              "Content-Type": "application/json",
              "Notion-Version": "2022-06-28"
            },
            "body": {
              "parent": "{{$fields.parent}}",
              "properties": "{{$fields.properties}}",
              "children": "{{$fields.children}}"
            }
          },
          "response": {"root_path": ""}
        },
        {
          "name": "retrieve",
          "label": "Retrieve Page",
          "fields": [
            {"name": "page_id", "label": "Page ID", "kind": "string", "required": true}
          ],
          "request": {
            "method": "GET",
            "url": "https://api.notion.com/v1/pages/{{$fields.page_id}}",
            "headers": {"Notion-Version": "2022-06-28"}
          },
          "response": {"root_path": ""}
        }
      ]
    },
    {
      "name": "databases",
      "label": "Databases",
      "operations": [
        {
          "name": "query",
          "label": "Query Database",
          "fields": [
            {"name": "database_id", "label": "Database ID", "kind": "string", "required": true},
            {"name": "filter", "label": "Filter", "kind": "json", "required": false, "default": {}},
            {"name": "sorts", "label": "Sorts", "kind": "json", "required": false, "default": []},
            {
              "name": "page_size",
              "label": "Page Size",
              "kind": "number",
              "required": false,
              "default": 100
            }
          ],
          "request": {
            "method": "POST",
            "url": "https://api.notion.com/v1/databases/{{$fields.database_id}}/query",
            "headers": {
              "Content-Type": "application/json",
              "Notion-Version": "2022-06-28"
            },
            "body": {
              "filter": "{{$fields.filter}}",
              "sorts": "{{$fields.sorts}}",
              "page_size": "{{$fields.page_size}}"
            }
          },
          "response": {
            "item_path": "results",
            "pagination": {
              "type": "cursor",
              "cursor_path": "next_cursor",
              "cursor_param": "start_cursor",
              "cursor_location": "body",
              "page_size": 100,
              "max_pages": 10
            }
          }
        },
        {
          "name": "retrieve",
          "label": "Retrieve Database",
          "fields": [
            {"name": "database_id", "label": "Database ID", "kind": "string", "required": true}
          ],
          "request": {
            "method": "GET",
            "url": "https://api.notion.com/v1/databases/{{$fields.database_id}}",
            "headers": {"Notion-Version": "2022-06-28"}
          },
          "response": {"root_path": ""}
        }
      ]
    },
    {
      "name": "blocks",
      "label": "Blocks",
      "operations": [
        {
          "name": "children.append",
          "label": "Append Block Children",
          "fields": [
            {"name": "block_id", "label": "Block ID", "kind": "string", "required": true},
            {"name": "children", "label": "Children", "kind": "json", "required": true}
          ],
          "request": {
            "method": "PATCH",
            "url": "https://api.notion.com/v1/blocks/{{$fields.block_id}}/children",
            "headers": {
              "Content-Type": "application/json",
              "Notion-Version": "2022-06-28"
            },
            "body": {
              "children": "{{$fields.children}}"
            }
          },
          "response": {"root_path": ""}
        }
      ]
    }
  ]
}
